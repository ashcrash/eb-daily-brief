{
  // Cloudflare Workers Static Assets deploy for the EB master dashboard.
  // The Worker (worker.js) runs FIRST on every request (run_worker_first) to
  // enforce Basic Auth, then serves the static site from ./dashboard via the
  // ASSETS binding. Password = DASH_PASSWORD env var (set in the CF dashboard).
  "name": "eb-daily-brief",
  "main": "worker.js",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
